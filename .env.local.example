NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
OPENWEATHER_API_KEY=your-openweather-api-key

# Daily blog LLM via Vercel AI Gateway (Claude by default)
# https://vercel.com/docs/ai-gateway — create a key and set it here / in Vercel env
AI_GATEWAY_API_KEY=
BLOG_MODEL=poolside/laguna-s-2.1-free
CRON_SECRET=generate-a-long-random-string

# Google Calendar OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
